DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where password-reset links point to
FRONTEND_URL=http://localhost:5173

# Defaults to printing emails to the console (fine for dev - no real email
# is sent). To actually send via Gmail SMTP:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      (select "Mail" - this is NOT your normal Gmail password)
#   3. Uncomment the block below and fill in your Gmail address + that
#      16-character app password (spaces don't matter).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@eventify.local

# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your16charapppassword
# DEFAULT_FROM_EMAIL=your-address@gmail.com
