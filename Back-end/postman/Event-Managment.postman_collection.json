{
  "info": {
    "name": "Event-Managment Auth API",
    "description": "Registration and authentication endpoints for the DRF backend. Run against the 'Event-Managment Local' environment with the dev server up on http://127.0.0.1:8000. Note: a full successful password-reset-confirm isn't included here, since the reset token is only ever delivered via the emailed link (printed to the runserver console in dev) - not retrievable through the API, by design. That path was verified manually (curl + browser) instead; this collection covers the request step and the confirm endpoint's validation errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testUsername')) {",
          "  pm.collectionVariables.set('testUsername', 'postman_' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Register - success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('returns a token', () => pm.expect(body.token).to.be.a('string'));",
              "pm.test('returns the created username', () => pm.expect(body.user.username).to.eql(pm.collectionVariables.get('testUsername')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testUsername}}@example.com\",\n  \"password\": \"{{testPassword}}\",\n  \"password2\": \"{{testPassword}}\",\n  \"first_name\": \"Post\",\n  \"last_name\": \"Man\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""] }
      }
    },
    {
      "name": "Register - duplicate username -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('error envelope has username detail', () => pm.expect(body.error.details.username).to.be.an('array'));",
              "pm.test('error code is bad_request', () => pm.expect(body.error.code).to.eql('bad_request'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
