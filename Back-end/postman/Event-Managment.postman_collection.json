      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"not-a-real-uid\",\n  \"token\": \"not-a-real-token\",\n  \"new_password\": \"BrandNewPass456\",\n  \"new_password2\": \"BrandNewPass456\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/password-reset-confirm/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "password-reset-confirm", ""] }
      }
    },
